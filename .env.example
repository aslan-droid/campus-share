# ============================================================
# CampusShare — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydet:
#   cp .env.example .env
# .env dosyasını asla Git'e commit etme!
# ============================================================

# ── Backend ─────────────────────────────────────────────────
PORT=5000

# ── PostgreSQL (docker-compose'daki servis adı: db) ─────────
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=campus_pass
DB_NAME=campus_db

# ── Mailpit SMTP (docker-compose'daki servis adı: mailpit) ──
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@campusshare.edu.tr

# ── Oturum / Token ───────────────────────────────────────────
SESSION_SECRET=degistir_bunu_guclu_bir_deger_yap
SESSION_HOURS=24

# ── Uygulama ─────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
